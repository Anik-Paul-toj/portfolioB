# Database (Local SQLite or Remote Turso/LibSQL)
DATABASE_URL="file:./dev.db"
# If using Turso (e.g. libsql://your-db-name.turso.io), provide your auth token:
DATABASE_AUTH_TOKEN=""

# NextAuth (Generate secret with: openssl rand -base64 32)
NEXTAUTH_URL="https://your-domain.vercel.app"
NEXTAUTH_SECRET="your-super-secret-key-change-this"

# Admin Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your-strong-password"

# Cloudinary Config
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_UPLOAD_PRESET="portfolio_preset"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="portfolio_preset"
MAX_VIDEO_SIZE_MB="100"

# EmailJS Config (https://www.emailjs.com)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=""
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=""
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=""
